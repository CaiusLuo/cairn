# Ignore local environment configuration
.env

# Ignore Python environments and bytecode files
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# Ignore Python test and coverage files
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Ignore build and distribution directories
build/
dist/

# Ignore LiteLLM-specific files
.litellm/
litellm_cache/

# Ignore local traces files
.cairn/*
