[Unit]
Description=Cairn Server (Web, Runtime, WeChat and Schedule)
Documentation=file://__CAIRN_ROOT__/docs/guides/runtime-service.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=__CAIRN_USER__
Group=__CAIRN_USER__
WorkingDirectory=__CAIRN_ROOT__
EnvironmentFile=-/etc/cairn/cairn.env
ExecStart=__CAIRN_ROOT__/.venv/bin/cairn --config __CAIRN_CONFIG__
UMask=0077
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=120
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
