[Unit]
Description=Cairn shared Agent Server
Documentation=file://__CAIRN_ROOT__/docs/guides/runtime-service.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=__CAIRN_USER__
Group=__CAIRN_USER__
WorkingDirectory=__CAIRN_ROOT__
Environment=HOME=__CAIRN_HOME__
Environment=XDG_STATE_HOME=__CAIRN_XDG_STATE_HOME__
EnvironmentFile=-/etc/cairn/cairn.env
ExecStart=__CAIRN_ROOT__/.venv/bin/cairn \
  --workspace __CAIRN_WORKSPACE__ \
  --state-dir __CAIRN_STATE__ \
  --worktrees __CAIRN_WORKTREES__ \
  --provider-approval __CAIRN_PROVIDER_APPROVAL__ \
  --port __CAIRN_PORT__
UMask=0077
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=120
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
